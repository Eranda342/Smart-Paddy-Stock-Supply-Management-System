# ──────────────────────────────────────────────────────────────────────────────
# AgroBridge Frontend — Environment Variables Template
#
# 1. Copy this file:  cp .env.example .env
# 2. Fill in every value marked  <...>
# 3. NEVER commit .env to version control — it is already in .gitignore
#
# Vite exposes only variables prefixed with VITE_ to the browser bundle.
# All three variables below are REQUIRED in production (the build will throw
# if any are missing when VITE's `import.meta.env.PROD` is true).
# ──────────────────────────────────────────────────────────────────────────────


# ── Backend API Base URL ───────────────────────────────────────────────────────
# The root URL of the Express REST API, including the /api path segment.
# No trailing slash.
#
# Development:  http://localhost:5000/api
# Production:   https://api.yourdomain.com/api
#
VITE_API_URL=http://localhost:5000/api


# ── Backend Socket.IO Base URL ─────────────────────────────────────────────────
# The root URL of the Socket.IO server — WITHOUT the /api suffix.
# Used by the Socket.IO client to establish the WebSocket connection.
#
# Development:  http://localhost:5000
# Production:   https://api.yourdomain.com
#
VITE_SOCKET_URL=http://localhost:5000


# ── Backend Base URL ───────────────────────────────────────────────────────────
# The root URL of the backend server (no /api suffix).
# Used for constructing direct server URLs (e.g. Google OAuth redirect link).
#
# Development:  http://localhost:5000
# Production:   https://api.yourdomain.com
#
VITE_BASE_URL=http://localhost:5000
