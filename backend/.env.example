# ──────────────────────────────────────────────────────────────────────────────
# AgroBridge Backend — Environment Variables Template
#
# 1. Copy this file:  cp .env.example .env
# 2. Fill in every value marked  <...>
# 3. NEVER commit .env to version control — it is already in .gitignore
# ──────────────────────────────────────────────────────────────────────────────


# ── Runtime Environment ────────────────────────────────────────────────────────
# Controls logging format, error stack traces, and DNS behaviour.
# Valid values: development | production | test
NODE_ENV=development


# ── Server ────────────────────────────────────────────────────────────────────
# Port the Express / Socket.IO server listens on.
PORT=5000

# Public URL of the frontend — used for Google OAuth redirects and email links.
# No trailing slash. In production set this to your real domain.
# Example production value: https://www.yourdomain.com
FRONTEND_URL=http://localhost:5173


# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB connection string.
# Local:   mongodb://127.0.0.1:27017/<your-db-name>
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<your-db-name>
MONGO_URI=mongodb://127.0.0.1:27017/<your-db-name>


# ── JWT ───────────────────────────────────────────────────────────────────────
# Secret used to sign and verify all JSON Web Tokens.
# Must be a long, random string — minimum 64 hex characters recommended.
# Generate one:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<your-random-jwt-secret-min-64-chars>


# ── Email (Gmail App Password) ─────────────────────────────────────────────────
# Nodemailer credentials for sending verification and notification emails.
#
# Setup:
#   1. Enable 2-Step Verification on the Gmail account.
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create an App Password (16 characters, no spaces).
#
EMAIL_USER=<your-gmail-address@gmail.com>
EMAIL_PASS=<your-16-char-gmail-app-password>

# Display name shown in the "From" field of outgoing emails.
FROM_NAME=AgroBridge


# ── Google OAuth 2.0 ──────────────────────────────────────────────────────────
# Credentials from the Google Cloud Console.
#
# Setup:
#   1. Go to https://console.cloud.google.com/apis/credentials
#   2. Create an OAuth 2.0 Client ID (Web application type).
#   3. Add your authorised redirect URI:
#      http://localhost:5000/api/auth/google/callback   (development)
#      https://api.yourdomain.com/api/auth/google/callback   (production)
#
GOOGLE_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-google-client-secret>


# ── Admin Creation Secret ──────────────────────────────────────────────────────
# Protects the /api/admin/create-admin route (secret-based seeding).
# If this variable is absent or empty the route is DISABLED (fail-closed).
#
# Requirements:
#   - Minimum 32 characters
#   - Treat as a password — rotate after the first admin account is created
#
# Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
ADMIN_SECRET=<your-min-32-char-admin-creation-secret>


# ── Cloudinary (Image Storage) ─────────────────────────────────────────────────
# Media upload credentials from your Cloudinary dashboard.
#
# Setup:
#   1. Sign up / log in at https://cloudinary.com/console
#   2. Copy the Cloud Name, API Key, and API Secret from the dashboard.
#
CLOUDINARY_CLOUD_NAME=<your-cloudinary-cloud-name>
CLOUDINARY_API_KEY=<your-cloudinary-api-key>
CLOUDINARY_API_SECRET=<your-cloudinary-api-secret>


# ── Logging ───────────────────────────────────────────────────────────────────
# Winston log level. Controls minimum severity of log output.
# Valid values (least → most verbose): error | warn | info | http | verbose | debug | silly
# Recommended: info (production)  |  debug (development)
LOG_LEVEL=info
